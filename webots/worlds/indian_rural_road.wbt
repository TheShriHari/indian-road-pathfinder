# ── POTHOLE HAZARD (Recessed road crater in ego travel lane) ─────────────────
DEF POTHOLE Solid {
  translation 18.0 -1.2 0.018
  children [
    # Dark asphalt crack rim
    Transform {
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.13
            roughness 0.9
          }
          geometry Cylinder {
            height 0.005
            radius 0.75
          }
        }
      ]
    }
    # Deep inner crater (mud/puddle bottom)
    Transform {
      translation 0 0 0.003
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.06 0.05 0.04
            roughness 0.2
            metalness 0.4
          }
          geometry Cylinder {
            height 0.006
            radius 0.55
          }
        }
      ]
    }
    # Pothole inner texture irregularity
    Transform {
      translation 0.15 -0.1 0.004
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.04 0.04 0.04
            roughness 0.1
          }
          geometry Cylinder {
            height 0.007
            radius 0.3
          }
        }
      ]
    }
  ]
  name "pothole"
}

