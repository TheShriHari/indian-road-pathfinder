#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "Indian Rural Road Simulation - SIH PS-26037"
    "Adaptive Path Planning for Unstructured Indian Roads"
    "Features: Pothole hazard, 2 crossing pedestrians, oncoming auto-rickshaw"
  ]
  title "Indian Rural Road"
  basicTimeStep 20
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.14 0.28 -0.94 1.15
  position -8.0 -1.75 4.5
  follow "EGO_VEHICLE"
  followSmoothness 0.05
}

Background {
  skyColor [
    0.45 0.68 0.92
  ]
}

DirectionalLight {
  direction 0.4 0.3 -0.85
  intensity 2.8
  castShadows TRUE
}

DirectionalLight {
  direction -0.4 -0.3 -0.5
  intensity 0.9
  castShadows FALSE
}

