# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ── MATLAB ──────────────────────────────────────────
*.asv                   # MATLAB auto-save backup files
*.m~                    # Editor temp files
slprj/                  # Simulink build cache
*.slxc
*.mex*                  # MEX compiled binaries
codegen/                # MATLAB Coder output

# ── Simulation Outputs ───────────────────────────────
*.gif                   # Demo animation exports
*.csv                   # Batch test result CSVs
trial*_trace.txt        # Per-trial debug logs
trial*.txt
batch_test_results*.csv
batch_test_results_sensor_layer*.csv

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
